{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run -m marketing init-db",
            "type": "python",
            "request": "launch",
            "module": "marketing",
            "args": [
                "init-db"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            // 1. 将当前工作目录 (Current Working Directory) 设为 backend 文件夹
            "cwd": "${workspaceFolder}/backend",
            // 2. 指向 backend 内部的 .env 文件
            "envFile": "${workspaceFolder}/.env",
            // 3. 确保 Python 能够正确找到模块
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        }
    ]
}