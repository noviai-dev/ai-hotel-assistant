# Copy to .env at the project root and set a strong password before starting.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Back up immediately on startup, then every 24 hours; keep 7 days.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Required only for actual competitor collection (--execute).
APIFY_TOKEN=

# Marketing worker (opt-in Compose profile; does not run collection).
OPENAI_API_KEY=
# Set a model available to your API project supporting Responses + Structured Outputs.
OPENAI_MODEL=
# Must exactly match collection_batches.own_hotel / competitors config own_hotel.
MARKETING_HOTEL=
MARKETING_TIMEZONE=Asia/Tokyo
MARKETING_HOUR=9
MARKETING_HORIZON_DAYS=60
MARKETING_FRESHNESS_DAYS=7

# Local Python only (Docker gets PG* values from POSTGRES_* above).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres

# Daily marketing email. Enable after filling SMTP and recipient settings.
MARKETING_EMAIL_ENABLED=false
MARKETING_EMAIL_TO=
MARKETING_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
# ssl (usually 465) or starttls (usually 587)
SMTP_SECURITY=ssl
SMTP_USERNAME=
# SMTP app password / authorization code
SMTP_PASSWORD=
